# Instance ROOT, without /rest-api/v1. HTTPS is required.
NERDIO_BASE_URL=
# https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
NERDIO_TOKEN_URL=
NERDIO_CLIENT_ID=
NERDIO_CLIENT_SECRET=
NERDIO_OAUTH_SCOPE=
# Comma-separated authorized NMM account IDs; enforced by server before API calls.
NERDIO_ALLOWED_ACCOUNT_IDS=
# Optional trusted-operator cross-account reads. Disabled by default.
NERDIO_ALLOW_ACCOUNT_DISCOVERY=false
NERDIO_ALLOW_GLOBAL_JOBS=false
# Enable preparation and execution of locally approved operations.
NERDIO_ENABLE_WRITES=false
# Optional ABSOLUTE private directory, shared by server and operator commands.
# Default: ~/.local/state/nerdio-nmm-mcp; use a different directory per deployment.
# NERDIO_STATE_DIR=/absolute/private/path/nerdio-nmm-state
