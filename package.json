{
  "name": "@flowdevs/nerdio-nmm-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Nerdio Manager for MSP MCP server with scoped inventory, operator-approved operations and job tracking",
  "type": "module",
  "bin": {
    "nerdio-nmm-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', {recursive:true, force:true});\"",
    "prepack": "npm run build",
    "doctor": "node dist/index.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flowdevs-io/nerdio-nmm-mcp.git"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "docs/INSTALL.md",
    "docs/API.md",
    "docs/VALIDATION.md",
    "LICENSE"
  ]
}
